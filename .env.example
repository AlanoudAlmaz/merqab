# Copy to .env and adjust. Never commit .env.

# Required for stable sessions: at least 32 random characters.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MIRQAB_SECRET_KEY=

# Storage (defaults to ./data)
MIRQAB_DATA_DIR=./data
# MIRQAB_DB_PATH=./data/mirqab.db
# MIRQAB_EVIDENCE_DIR=./data/evidence

# Limits
MIRQAB_MAX_UPLOAD_MB=10
MIRQAB_RATE_LIMIT_PER_MIN=30
MIRQAB_TOKEN_TTL_MIN=480

# Privacy: keep false to avoid storing text submitted to public checks
MIRQAB_STORE_ANALYSIS_TEXT=false

# OCR for screenshots (requires the Tesseract binary with 'eng' and 'ara' language data)
MIRQAB_OCR_ENABLED=true

# Live Threat Radar: follows public Certificate Transparency logs and the OpenPhish feed (needs internet)
MIRQAB_RADAR_ENABLED=true

# Optional AI language model layer. Leave provider as "none" to use the rule engine only.
MIRQAB_LLM_PROVIDER=none
# MIRQAB_LLM_PROVIDER=anthropic
# MIRQAB_LLM_PROVIDER=openai   (uses OPENAI_API_KEY; also enables the AI visual review in the deepfake scan)
OPENAI_API_KEY=
# MIRQAB_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
MIRQAB_LLM_MODEL=claude-sonnet-5-5
MIRQAB_LLM_TIMEOUT=20

# Only needed if the frontend is served from another origin (comma-separated)
MIRQAB_CORS_ORIGINS=

# Demo seeding (python -m backend.app.cli seed-demo). Leave empty to generate random passwords.
MIRQAB_DEMO_INVESTIGATOR_PASSWORD=
MIRQAB_DEMO_REVIEWER_PASSWORD=
MIRQAB_DEMO_ADMIN_PASSWORD=

# Hardening
# Extra host names allowed in the Host header (DNS-rebinding protection). localhost / 127.0.0.1 / ::1 are always allowed.
# MIRQAB_ALLOWED_HOSTS=mirqab.example.ae
# Interactive API docs at /api/docs (off by default)
# MIRQAB_API_DOCS=false
